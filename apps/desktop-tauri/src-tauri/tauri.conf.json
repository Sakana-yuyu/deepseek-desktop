{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepSeek Harness",
  "version": "0.1.0-rc.5",
  "identifier": "ai.deepseek.dsh-desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1430",
    "beforeDevCommand": "node scripts/prepare-dist.mjs && node scripts/serve-dist.mjs",
    "beforeBuildCommand": "node scripts/prepare-dist.mjs"
  },
  "app": {
    "windows": [
      {
        "label": "splash",
        "title": "DeepSeek Harness",
        "width": 440,
        "height": 300,
        "resizable": false,
        "center": true,
        "decorations": true,
        "url": "splash.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "appimage", "deb"],
    "category": "DeveloperTool",
    "shortDescription": "DeepSeek Harness desktop shell",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../bundled/harness": "harness-source"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "SimpChinese", "TradChinese"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
