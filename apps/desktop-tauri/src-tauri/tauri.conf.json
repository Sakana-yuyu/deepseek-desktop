{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepSeek Harness",
  "version": "0.1.0-rc.5-0.2",
  "identifier": "ai.deepseek.dsh-desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1430",
    "beforeDevCommand": "node scripts/prepare-dist.mjs && node scripts/serve-dist.mjs",
    "beforeBuildCommand": "node scripts/prepare-dist.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "splash",
        "title": "DeepSeek Harness",
        "width": 440,
        "height": 300,
        "resizable": false,
        "center": true,
        "decorations": false,
        "url": "splash.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIyOTU4Q0I3RkU0OTUzOEMKUldTTVUwbit0NHlWSWxwMDJ2TzQreUZ4cVFqejg1R0JpYU9tdWxPQlR5L1ViSjRKaVlML2x0UXcK",
      "endpoints": [
        "https://github.com/Sakana-yuyu/deepseek-harness-desktop/releases/download/desktop-updater/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "dmg", "appimage", "deb"],
    "category": "DeveloperTool",
    "shortDescription": "DeepSeek Harness desktop shell",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../bundled/harness": "harness-source",
      "../overlay/desktop-notify": "desktop-overlay",
      "../sounds/complete.wav": "complete.wav",
      "icons/icon.ico": "deepseek-harness-icon-0.1.0-rc.5-0.2.ico"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "SimpChinese", "TradChinese"],
        "displayLanguageSelector": false,
        "installerHooks": "./windows/installer-hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
